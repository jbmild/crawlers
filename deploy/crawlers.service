[Unit]
Description=Plataforma de crawlers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crawlers
Group=crawlers
WorkingDirectory=/opt/crawlers
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/crawlers/.env
ExecStart=/opt/crawlers/.venv/bin/python -m crawler_platform
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
